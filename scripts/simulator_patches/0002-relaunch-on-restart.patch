diff --git a/src/SimulatorLifecycle.cpp b/src/SimulatorLifecycle.cpp
index 03c4fc7..1a3bdfe 100644
--- a/src/SimulatorLifecycle.cpp
+++ b/src/SimulatorLifecycle.cpp
@@ -3,8 +3,11 @@
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <string>
 #include <unistd.h>
 
+#include "Arduino.h"
+
 namespace {
 
 constexpr const char *kWakeReasonEnv = "CROSSPOINT_SIM_WAKE_REASON";
@@ -14,8 +17,75 @@ constexpr const char *kInputScriptAfterWakeEnv =
 constexpr const char *kScreenshotsEnv = "CROSSPOINT_SIM_SCREENSHOTS";
 constexpr const char *kScreenshotsAfterWakeEnv =
     "CROSSPOINT_SIM_SCREENSHOTS_AFTER_WAKE";
+constexpr const char *kScriptOffsetEnv = "CROSSPOINT_SIM_SCRIPT_OFFSET_MS";
+constexpr const char *kRtcFileEnv = "CROSSPOINT_SIM_RTC_FILE";
 char **gArgv = nullptr;
 
+#if defined(__linux__)
+// Bounds of the RTC_NOINIT_ATTR section (see Arduino.h); the linker provides
+// them. Weak, so a firmware with no RTC variables still links.
+extern "C" {
+extern char __start_sim_rtc_noinit[] __attribute__((weak));
+extern char __stop_sim_rtc_noinit[] __attribute__((weak));
+}
+
+size_t rtcSize() {
+  if (!__start_sim_rtc_noinit || !__stop_sim_rtc_noinit)
+    return 0;
+  return static_cast<size_t>(__stop_sim_rtc_noinit - __start_sim_rtc_noinit);
+}
+
+void saveRtcMemory() {
+  const size_t size = rtcSize();
+  if (size == 0)
+    return;
+  char path[] = "/tmp/crosspoint-sim-rtc-XXXXXX";
+  const int fd = mkstemp(path);
+  if (fd < 0)
+    return;
+  const bool ok =
+      write(fd, __start_sim_rtc_noinit, size) == static_cast<ssize_t>(size);
+  close(fd);
+  if (ok) {
+    setenv(kRtcFileEnv, path, 1);
+  } else {
+    unlink(path);
+  }
+}
+
+// Runs before the firmware's static initialisers, so nothing sees the memory
+// before it is restored. A cold boot has no file and keeps the zeroed section.
+__attribute__((constructor(101))) void restoreRtcMemory() {
+  const char *path = std::getenv(kRtcFileEnv);
+  if (!path)
+    return;
+  const size_t size = rtcSize();
+  if (FILE *file = std::fopen(path, "rb")) {
+    std::string saved(size + 1, '\0');
+    // A different size means a different binary wrote it: start cold instead.
+    if (std::fread(saved.data(), 1, size + 1, file) == size)
+      std::memcpy(__start_sim_rtc_noinit, saved.data(), size);
+    std::fclose(file);
+  }
+  unlink(path);
+  unsetenv(kRtcFileEnv);
+}
+#else
+void saveRtcMemory() {}
+#endif
+
+[[noreturn]] void relaunch() {
+  if (!gArgv || !gArgv[0]) {
+    std::fputs("SimulatorLifecycle: missing argv for reboot\n", stderr);
+    _exit(1);
+  }
+  saveRtcMemory();
+  execvp(gArgv[0], gArgv);
+
+  std::perror("execvp");
+  _exit(1);
+}
+
 void promoteAfterWakeValue(const char *target, const char *afterWake) {
   const char *value = std::getenv(afterWake);
   if (value) {
@@ -46,11 +116,6 @@ WakeReason consumeWakeReason() {
 }
 
 [[noreturn]] void rebootAsPowerWake() {
-  if (!gArgv || !gArgv[0]) {
-    std::fputs("SimulatorLifecycle: missing argv for reboot\n", stderr);
-    _exit(1);
-  }
-
   setenv(kWakeReasonEnv, "power", 1);
   // A deep-sleep wake is a fresh process. Do not replay the pre-sleep script,
   // which would otherwise put every relaunched process back to sleep forever.
@@ -58,10 +123,23 @@ WakeReason consumeWakeReason() {
   // or terminate the relaunched instance.
   promoteAfterWakeValue(kInputScriptEnv, kInputScriptAfterWakeEnv);
   promoteAfterWakeValue(kScreenshotsEnv, kScreenshotsAfterWakeEnv);
-  execvp(gArgv[0], gArgv);
+  unsetenv(kScriptOffsetEnv);
+  relaunch();
+}
 
-  std::perror("execvp");
-  _exit(1);
+[[noreturn]] void rebootAsRestart() {
+  setenv(kScriptOffsetEnv, std::to_string(scriptClockMs()).c_str(), 1);
+  relaunch();
+}
+
+unsigned long scriptClockOffsetMs() {
+  static const unsigned long offset = [] {
+    const char *value = std::getenv(kScriptOffsetEnv);
+    return value ? std::strtoul(value, nullptr, 10) : 0UL;
+  }();
+  return offset;
 }
 
+unsigned long scriptClockMs() { return millis() + scriptClockOffsetMs(); }
+
 } // namespace SimulatorLifecycle
diff --git a/src/SimulatorLifecycle.h b/src/SimulatorLifecycle.h
index 5ab7350..6a443c2 100644
--- a/src/SimulatorLifecycle.h
+++ b/src/SimulatorLifecycle.h
@@ -8,4 +8,15 @@ void initProcessArgs(char** argv);
 WakeReason consumeWakeReason();
 [[noreturn]] void rebootAsPowerWake();
 
+// ESP.restart(): relaunch without a wake reason. RTC_NOINIT memory survives, and
+// the input/screenshot schedules carry on from where they were, so one script
+// can span the restart.
+[[noreturn]] void rebootAsRestart();
+
+// millis() plus the time spent in the processes before an ESP.restart(). The
+// input and screenshot schedules run on this clock.
+unsigned long scriptClockMs();
+// Schedule entries at or before this already ran in an earlier process.
+unsigned long scriptClockOffsetMs();
+
 }  // namespace SimulatorLifecycle
