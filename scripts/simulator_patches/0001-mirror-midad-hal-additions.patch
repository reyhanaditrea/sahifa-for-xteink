+++ b/src/HalSystem.h
@@ -18,4 +18,6 @@ void clearPanic();
 
 std::string getPanicInfo(bool full = false);
 bool isRebootFromPanic();
+// Firmware samples heap once per loop tick for panic reports; the host has none.
+inline void noteHeap(uint32_t, uint32_t) {}
 } // namespace HalSystem
diff --git a/src/esp_http_client.h b/src/esp_http_client.h
index 5195290..32b269d 100644
--- a/src/esp_http_client.h
+++ b/src/esp_http_client.h
@@ -1,5 +1,6 @@
 #pragma once
 
+#include <cstdio>
 #include <cstring>
 #include <map>
 #include <string>
@@ -97,6 +98,24 @@ inline esp_err_t esp_http_client_set_header(esp_http_client_handle_t handle,
   return ESP_OK;
 }
 
+inline esp_err_t esp_http_client_delete_header(esp_http_client_handle_t handle,
+                                               const char *name) {
+  if (!handle || !name)
+    return ESP_FAIL;
+  handle->headers.erase(name);
+  return ESP_OK;
+}
+
+// Redirects are followed inside the host fetch, so the URL never changes from
+// the configured one.
+inline esp_err_t esp_http_client_get_url(esp_http_client_handle_t handle,
+                                         char *url, int len) {
+  if (!handle || !url || len <= 0 || !handle->config.url)
+    return ESP_FAIL;
+  std::snprintf(url, static_cast<size_t>(len), "%s", handle->config.url);
+  return ESP_OK;
+}
+
 inline esp_err_t esp_http_client_set_post_field(esp_http_client_handle_t handle,
                                                 const char *data, int len) {
   if (!handle)
