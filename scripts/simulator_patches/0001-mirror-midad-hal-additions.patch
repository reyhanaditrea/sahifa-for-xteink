From a0cedef1433ea1e536e62f8962374f6bb83e8837 Mon Sep 17 00:00:00 2001
From: patch <patch@local>
Date: Sat, 19 Sep 2026 18:06:16 +0700
Subject: [PATCH] Mirror Midad firmware HAL and SDK additions

Midad's lib/hal and ESP-IDF usage have grown past what upstream shims:
HalClock system-time helpers, HalSystem::noteHeap, HalDisplay's
forceCleanBaseOnHalf overloads, HalGPIO::verifyPowerButtonWakeup(ms, short),
esp_http_client_get_url/delete_header, vSemaphoreDelete, pdPASS and
random(min, max).
---
 src/Arduino.h           |  1 +
 src/HalClock.h          |  8 ++++++++
 src/HalDisplay.h        |  6 ++++++
 src/HalGPIO.h           |  1 +
 src/HalSystem.h         |  2 ++
 src/esp_http_client.h   | 19 +++++++++++++++++++
 src/freertos/FreeRTOS.h |  2 ++
 src/freertos/semphr.h   | 15 ++++++++++++---
 8 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/src/Arduino.h b/src/Arduino.h
index e00363d..8dc44a9 100644
--- a/src/Arduino.h
+++ b/src/Arduino.h
@@ -73,6 +73,7 @@ struct ESPMock {
 extern ESPMock ESP;
 
 inline long random(long max) { return std::rand() % max; }
+inline long random(long min, long max) { return max > min ? min + std::rand() % (max - min) : min; }
 
 template <typename A, typename B>
 constexpr auto max(A a, B b) -> decltype(a > b ? a : b) {
diff --git a/src/HalClock.h b/src/HalClock.h
index 638cffc..a35bdf5 100644
--- a/src/HalClock.h
+++ b/src/HalClock.h
@@ -26,4 +26,12 @@ class HalClock {
   bool formatDate(char* buf, size_t bufSize,
                   uint8_t utcOffsetQuarterHoursBiased = 48) const;
   bool syncFromNTP();
+
+  // Firmware HAL additions (lib/hal/HalClock.h). The host clock is always a real
+  // calendar date, so there is nothing to restore or sync.
+  bool rtcHasCalendarDate() const { return _available; }
+  static constexpr time_t MIN_PLAUSIBLE_EPOCH = 1704067200;
+  static bool isSystemTimeValid() { return std::time(nullptr) >= MIN_PLAUSIBLE_EPOCH; }
+  static bool quickSyncSystemTime() { return isSystemTimeValid(); }
+  static void stopSntp() {}
 };
diff --git a/src/HalDisplay.h b/src/HalDisplay.h
index af607ac..f407655 100644
--- a/src/HalDisplay.h
+++ b/src/HalDisplay.h
@@ -70,6 +70,12 @@ public:
   void displayBuffer(RefreshMode mode = RefreshMode::FAST_REFRESH,
                      bool turnOffScreen = false);
   void displayBufferAsync(RefreshMode mode = RefreshMode::FAST_REFRESH);
+  // Firmware HAL forceCleanBaseOnHalf: an X3 panel-sync detail with no host
+  // equivalent, so it is accepted and dropped.
+  void displayBuffer(RefreshMode mode, bool turnOffScreen, bool) {
+    displayBuffer(mode, turnOffScreen);
+  }
+  void displayBufferAsync(RefreshMode mode, bool) { displayBufferAsync(mode); }
   void waitRefreshComplete();
   bool supportsAsyncRefresh() const;
   void displayWindow(int x, int y, int w, int h);
diff --git a/src/HalGPIO.h b/src/HalGPIO.h
index 9d60c91..54d959f 100644
--- a/src/HalGPIO.h
+++ b/src/HalGPIO.h
@@ -95,6 +95,7 @@ public:
   // Verify power button was held long enough after wakeup.
   // The host wake path is synthetic, so verification always succeeds.
   bool verifyPowerButtonWakeup();
+  bool verifyPowerButtonWakeup(uint16_t, bool) { return verifyPowerButtonWakeup(); }
 
   // Check if USB is connected
   bool isUsbConnected() const;
diff --git a/src/HalSystem.h b/src/HalSystem.h
index 3037826..23608f1 100644
