diff --git a/src/freertos/semphr.h b/src/freertos/semphr.h
index bd03b35..ec9c53c 100644
--- a/src/freertos/semphr.h
+++ b/src/freertos/semphr.h
@@ -41,9 +41,9 @@ typedef SimSemaphoreBase *SemaphoreHandle_t;
 
 namespace sim_semaphore_detail {
 
-// Single non-virtual base, so a tag-checked downcast is exact. Nothing frees a
-// handle in this shim (there is no vSemaphoreDelete), so no base-pointer delete
-// happens and the base needs no virtual destructor.
+// Single non-virtual base, so a tag-checked downcast is exact. vSemaphoreDelete
+// frees through the same downcast, so no base-pointer delete happens and the
+// base needs no virtual destructor.
 inline SimMutex *asMutex(SemaphoreHandle_t sem) {
   return static_cast<SimMutex *>(sem);
 }
@@ -61,6 +61,15 @@ inline std::chrono::milliseconds ticksToDuration(uint32_t ticks) {
 
 } // namespace sim_semaphore_detail
 
+inline void vSemaphoreDelete(SemaphoreHandle_t sem) {
+  if (!sem)
+    return;
+  if (sem->kind == SimSemaphoreKind::Binary)
+    delete sim_semaphore_detail::asBinary(sem);
+  else
+    delete sim_semaphore_detail::asMutex(sem);
+}
+
 inline SemaphoreHandle_t xSemaphoreCreateMutex() { return new SimMutex(); }
 
